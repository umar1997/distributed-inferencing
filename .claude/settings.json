{
  "$schema_note": "AWAY FROM THE KEYBOARD. Lets Claude build, test and run Docker for this project without asking. Still asks (and so waits for you) before commits, merges, pushes, deleting files or installing new kinds of packages. Precedence: deny > ask > allow. Switch back to at-keyboard.json when you return.",
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker stats:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -sN localhost:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(cd:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(git add:*)",
      "Bash(git checkout -b:*)",
      "Bash(pkill -f vite:*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "ask": [
      "Bash(git branch -D:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(npm test:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(poetry:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh auth:*)",
      "Edit(package.json)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Write(.env*)",
      "Write(.git/**)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker rm -f umar_:*)",
      "Bash(docker stop umar_:*)",
      "Bash(docker stop speech-to-speech:*)"
    ]
  }
}
