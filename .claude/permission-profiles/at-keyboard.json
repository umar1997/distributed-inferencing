{
  "$schema_note": "AT THE KEYBOARD. Precedence: deny > ask > allow, so an 'ask' rule beats every 'allow' rule it matches. Commands in no list are asked about anyway; 'ask' is only needed to make an exception to a broader 'allow'.",
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker stats:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -sN localhost:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "ask": [
      "Bash(git branch -D:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(npm test:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(npm publish:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(poetry:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh auth:*)",
      "Edit(package.json)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Write(.env*)",
      "Write(.git/**)"
    ]
  }
}
