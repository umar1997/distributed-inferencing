# Example settings for one laptop. Normally `./moe setup` writes node.env for you.
# By hand: cp node.env.example node.env, fill in the values, then ./moe download (docs/LAPTOP_SETUP.md).
# node.env is never committed (it holds the cluster token); this example file is.

# master or worker (exactly one master)
NODE_ROLE=worker
# unique name, shown in logs and on the web page
NODE_ID=laptop-b
# 8000 on the master, 8100 on a worker
LISTEN_PORT=8100
# experts this laptop holds in every layer: 0-10, or 0,4,8, or 0-3,8,12-15 (all laptops together: 0-31)
EXPERT_IDS=11-21
# workers only: the master's IP and port
MASTER_ADDR=192.168.1.10:8000
# workers only: auto = this laptop's current IP (found at every start), or a fixed one like 192.168.1.21:8100
ADVERTISE_ADDR=auto
# the same shared password on every laptop (the master's setup makes one)
CLUSTER_TOKEN=change-me
# must match the master
MODEL_ID=ibm-granite/granite-3.0-1b-a400m-instruct
DTYPE=bf16
